# Google スプレッドシートのID（URLの /d/XXXXXXX/edit の部分）
SPREADSHEET_ID=your_spreadsheet_id_here

# シート名（デフォルト値のまま変更不要な場合はコメントアウト可）
INPUT_SHEET=会社リスト
OUTPUT_SHEET=物件情報

# サービスアカウントの認証情報JSONファイルのパス
GOOGLE_CREDENTIALS=credentials.json

# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-...

# LINE通知（新規物件検知時に送信。reins/scraper/.env と同じ値を使い回してOK）
# 宛先は LINE_USER_ID（本人）固定。物件ウォッチの新着は自分だけに届ける方針なので、
# reins 側の LINE_TO（グループ宛）はこのスクレイパーでは参照しない。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# PWA(docs/watch/) アプリアイコンのバッジ表示（Web Push）用。
# GAS_URL/SECRET_TOKEN は realestate/gas の Web App と同じ値（購読者一覧の取得に使う）。
# VAPID秘密鍵は reins と共用（既定で ../reins/scraper/vapid_private.pem を見る）。
# 鍵の生成方法は reins/scraper/.env.example を参照。
GAS_URL=
SECRET_TOKEN=
VAPID_SUBJECT=mailto:your-email@example.com
