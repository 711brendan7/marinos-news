REINS_USER_ID=あなたのユーザーID
REINS_PASSWORD=あなたのパスワード
REINS_CONDITION=三浦
# 検索対象の保存条件キーワード（カンマ区切り・省略時は REINS_CONDITION のみ）。
# 例: 三浦,秋谷 で「三浦」「秋谷」を含む保存条件を全て巡回。取得物件は同一シートに記録。
REINS_CONDITIONS=三浦,秋谷
GAS_URL=https://script.google.com/macros/s/AKfycbzKJJZ2F_3eypnYN3mugVrPBRNv1G7cbS5y2nmLP7qMsEdaL8-S7Ow-R7yAgOTrzWxOZw/exec
HEADLESS=false
# 通知の宛先上書き（省略可）。LINE_TO を指定するとそこへ push（グループID等）。
# LINE_TO_ADACHI は足立区の独立巡回（run_adachi.sh）専用の通知先（LINEグループID）。
LINE_TO_ADACHI=
# 足立区の専用スプレッドシートを固定（作り直さない＝新着のみ通知・PWA merge先と一致）。
# GAS Code.gs の MERGE_SIDS もこのシートIDに合わせること。
REINS_SPREADSHEET_URL_ADACHI=

# PWAアプリアイコンのバッジ表示（Web Push）用。
# VAPID鍵ペアの生成（秘密鍵=vapid_private.pem / 公開鍵=下のVAPID_PUBLIC_KEY と docs/reins.html に埋める）:
#   venv/bin/python -c "from py_vapid import Vapid02; from cryptography.hazmat.primitives import serialization as s; import base64; \
#     v=Vapid02(); v.generate_keys(); open('vapid_private.pem','w').write(v.private_pem().decode()); \
#     print(base64.urlsafe_b64encode(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
# 鍵を作り直すと既存の購読は全て無効になり、各端末で🔔通知を押し直す必要がある。
VAPID_PRIVATE_KEY_FILE=vapid_private.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# 物件データ読み出し用トークン（reins/Code.gs の READ_TOKEN と一致させる）。
REINS_READ_TOKEN=
