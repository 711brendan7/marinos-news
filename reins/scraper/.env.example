REINS_USER_ID=あなたのユーザーID
REINS_PASSWORD=あなたのパスワード
REINS_CONDITION=三浦
# 検索対象の保存条件キーワード（カンマ区切り・省略時は REINS_CONDITION のみ）。
# 例: 三浦,秋谷 で「三浦」「秋谷」を含む保存条件を全て巡回。取得物件は同一シートに記録。
REINS_CONDITIONS=三浦,秋谷
GAS_URL=https://script.google.com/macros/s/AKfycbzKJJZ2F_3eypnYN3mugVrPBRNv1G7cbS5y2nmLP7qMsEdaL8-S7Ow-R7yAgOTrzWxOZw/exec
HEADLESS=false
# 通知の宛先上書き（省略可）。LINE_TO を指定するとそこへ push（グループID等）。
# LINE_TO_ADACHI は足立区の独立巡回（run_adachi.sh）専用の通知先（LINEグループID）。
LINE_TO_ADACHI=
